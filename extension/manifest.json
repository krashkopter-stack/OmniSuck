{
  "manifest_version": 3,
  "name": "OmniSuck",
  "version": "1.1",
  "description": "Скачивает видео (и фото из постов Instagram) в один клик.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["https://*.instagram.com/*"],
  "background": { "service_worker": "bg.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
